{
  "kind": "event_trigger",
  "version": "0.1.0",
  "title": "Event Trigger",
  "description": "Emit bounded timer, calendar or stable-file events while the Run is active.",
  "repository_url": "https://github.com/HackInvent/bloxmith-event-trigger",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "POSIX/Linux and system IANA timezone database for calendar mode. Folder mode requires an existing local filesystem directory."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "command",
        "title": "command",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "event",
        "title": "event",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "status",
        "title": "status",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "mode": "interval",
    "interval_sec": 60,
    "daily_time": "09:00",
    "timezone": "UTC",
    "weekdays": [
      0,
      1,
      2,
      3,
      4,
      5,
      6
    ],
    "watch_directory": "",
    "pattern": "*",
    "stable_sec": 2,
    "poll_sec": 1,
    "include_existing": false,
    "start_paused": false,
    "max_entries": 1000,
    "max_pending": 64,
    "emit_per_sec": 2,
    "payload": {}
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "file_browser": true,
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
